#!/usr/bin/env python3
"""Lint version-scoped guidance: parsable ranges, balanced markers, topic ids, adjoining ranges per topic.

  oro-skills-lint [--root DIR] [PATH...]    exit 0 clean, 1 violations, 64 usage
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from oroversion import lint  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(prog="oro-skills-lint", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="*")
    ap.add_argument("--root", default=os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
    try:
        a = ap.parse_args(argv)
    except SystemExit as exc:
        return 64 if exc.code else 0
    root = os.path.abspath(a.root)
    missing = [p for p in a.paths if not os.path.exists(p)]
    if missing:
        sys.stderr.write("oro-skills-lint: no such path %s\n" % ", ".join(missing))
        return 64
    problems, warns = lint.lint_all(root, [os.path.abspath(p) for p in a.paths] or None)
    for w in warns:
        sys.stderr.write("warning: %s\n" % w)
    for p in problems:
        print(p)
    if problems:
        sys.stderr.write("oro-skills-lint: %d violation(s)\n" % len(problems))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
