#!/usr/bin/env python3
"""Register the atlas hooks in <project>/.claude/settings.local.json (idempotent), then build the index."""
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
HOOKS = os.path.join(os.path.dirname(HERE), "hooks")
REGISTRATIONS = [
    ("PreToolUse", "Edit|Write|MultiEdit", "pretooluse_edit.py"),
    ("PostToolUse", "Bash", "posttooluse_bash.py"),
    ("PostToolUse", "Edit|Write|MultiEdit", "posttooluse_edit.py"),
    ("UserPromptSubmit", None, "userpromptsubmit.py"),
    ("SubagentStart", None, "subagentstart.py"),
]


def command_for(script):
    return "python3 %s" % os.path.join(HOOKS, script)


def merge(settings):
    """Add each atlas hook unless a command for that script is already registered under the event."""
    hooks = settings.setdefault("hooks", {})
    for event, matcher, script in REGISTRATIONS:
        groups = hooks.setdefault(event, [])
        present = any(script in h.get("command", "") and "oro-atlas" in h.get("command", "") for g in groups for h in g.get("hooks", []))
        entry = {"hooks": [{"type": "command", "command": command_for(script), "timeout": 10}]}
        if matcher:
            entry = {"matcher": matcher, **entry}
        if not present:
            groups.append(entry)
    return settings


GIT_HOOKS = ("post-checkout", "post-merge", "post-rewrite")
MARK = "# oro-atlas: refresh index"


def git_hook_body(name):
    # post-checkout's third argument is 0 for a single-file checkout, which moves no code.
    guard = '[ "$3" = "0" ] && exit 0\n' if name == "post-checkout" else ""
    return (
        "#!/bin/sh\n%s\n%s"
        '( "%s" --project "$(git rev-parse --show-toplevel)" --incremental --background >/dev/null 2>&1 & )\n'
        % (MARK, guard, os.path.join(HERE, "atlas-build"))
    )


def install_git_hooks(project):
    """Silent background refresh after checkout/merge/rebase; never touches a hook that is not ours."""
    p = subprocess.run(["git", "-C", project, "rev-parse", "--git-path", "hooks"], capture_output=True, text=True)
    if p.returncode != 0:
        return ["git hooks: not a git work tree, skipped"]
    hooks_dir = os.path.join(project, p.stdout.strip())
    notes = []
    for name in GIT_HOOKS:
        path = os.path.join(hooks_dir, name)
        existing = open(path, encoding="utf-8", errors="replace").read() if os.path.isfile(path) else None
        if existing is not None and MARK not in existing:
            notes.append("git hook %s exists and is not atlas's: left alone; add `atlas-build --incremental --background` to it" % name)
            continue
        os.makedirs(hooks_dir, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(git_hook_body(name))
        os.chmod(path, 0o755)
        notes.append("git hook %s: installed" % name)
    return notes


def main(argv):
    project = os.path.abspath(argv[1]) if len(argv) > 1 else ""
    if not os.path.isfile(os.path.join(project, "bin", "console")):
        sys.stderr.write("usage: atlas-setup <oro-project-root>\n")
        return 2
    path = os.path.join(project, ".claude", "settings.local.json")
    settings = {}
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as fh:
            settings = json.load(fh)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(merge(settings), fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
    print("hooks registered in %s" % path)
    for note in install_git_hooks(project):
        print(note)
    build = [] if "--no-build" in argv else [sys.executable, os.path.join(HERE, "atlas-build"), "--project", project]
    return subprocess.call(build) if build else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
