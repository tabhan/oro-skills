#!/usr/bin/env python3
"""Print the Oro version of a project (from composer.lock). Exit 0 known, 4 unknown, 64 usage."""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from oroversion import detect  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(prog="oro-version", description=__doc__)
    ap.add_argument("--project", default=os.getcwd())
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-cache", action="store_true", help="ignore and do not write .oro-ai/version.json")
    try:
        args = ap.parse_args(argv)
    except SystemExit as exc:
        return 64 if exc.code else 0
    r = detect(os.path.abspath(args.project), use_cache=not args.no_cache, write_cache=not args.no_cache)
    if args.json:
        print(json.dumps(r.as_dict(), indent=2))
    elif r.known:
        print(r.version)
    else:
        sys.stderr.write("oro-version: unknown (%s)\n" % r.reason)
    for w in r.warnings:
        sys.stderr.write("oro-version: warning: %s\n" % w)
    return 0 if r.known else 4


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
