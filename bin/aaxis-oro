#!/usr/bin/env python3
"""aaxis-oro: single entry for the atlas index, local environment scripts, test runner, version guidance and plugin lint."""
import json
import os
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
SCRIPTS = os.path.join(ROOT, "scripts", "local-env")
sys.path.insert(0, os.path.join(ROOT, "lib"))
sys.path.insert(0, os.path.join(ROOT, "atlas"))

HELP = """usage: aaxis-oro <group> [args]

  atlas    <entity|event|service|tag|unsafe|grid|workflow|operation|mq|config|layout|js|search|notes|status>
           <term> | build | setup | precommit | migrate    extension-point index (atlas --help)
  memory   <inventory|apply>                                   migrate project auto-memory to .oro-ai/notes
  env      check|repair|reset|baseline|import-attachments|restore|workers|switch   local environment
  test     [--project P] <local|local-test> <phpunit|e2e|console|verify> [args]   explicit-target runner
  version  [diff|applies]                                      Oro version and which guidance applies
  spec     coverage|report                                     spec AC traceability: static coverage, run verification
  dev      lint                                                lint the plugin's version-scoped guidance
"""

ENV_SCRIPTS = {
    "check": "check.sh", "repair": "repair.sh", "reset": "reset.sh", "baseline": "baseline.sh",
    "import-attachments": "import-attachments.sh", "restore": "restore-local.sh", "workers": "workers.sh",
    "switch": "switch.sh",
}
ENV_HELP = """usage: aaxis-oro env <command> [--project P] [--dry-run] [--verbose]

  check [--json]            drift report (exit 2 on drift)        repair [--only X]      fix what check reports
  reset [--skip-reindex]    reset the test stack                  baseline [--refresh]   build the test baseline
  import-attachments        qa attachments into GridFS            restore --yes          qa dump into the local db
  workers [--write]         e2e worker count                      switch <project>       host switch (sudo, user-run)
"""
TEST_HELP = """usage: aaxis-oro test [--project P] <local|local-test> <phpunit|e2e|console|verify> [args...]

  local-test  phpunit (ORO_ENV=test), e2e (aaxis:test:e2e on behat_test), console (default --env=behat_test)
  local       console only (default --env=prod)
  verify      print the target verification line only
Exit: the command's own code; 3 target mismatch or refused combination; 64 usage.
"""
DEV_HELP = "usage: aaxis-oro dev lint [--root DIR] [PATH...]\n"
HELPS = {"-h", "--help", "help"}


def plugin_version():
    with open(os.path.join(ROOT, ".claude-plugin", "plugin.json"), encoding="utf-8") as fh:
        return json.load(fh)["version"]


def run_script(name, args):
    path = os.path.join(SCRIPTS, name)
    os.execv(path, [path] + args)


def main(argv):
    group, rest = (argv[0], argv[1:]) if argv else ("--help", [])
    code = 64
    if group in HELPS:
        sys.stdout.write(HELP)
        code = 0
    elif group == "--version":
        print("aaxis-oro %s" % plugin_version())
        code = 0
    elif group == "atlas":
        from atlas import cli
        code = cli.main(rest)
    elif group == "memory":
        from atlas import notesmigrate
        code = notesmigrate.main(rest)
    elif group == "env":
        if rest[:1] and rest[0] in ENV_SCRIPTS:
            run_script(ENV_SCRIPTS[rest[0]], rest[1:])
        sys.stdout.write(ENV_HELP) if not rest or rest[0] in HELPS else sys.stderr.write(ENV_HELP)
        code = 0 if not rest or rest[0] in HELPS else 64
    elif group == "test":
        if not rest or rest[0] in HELPS:
            sys.stdout.write(TEST_HELP)
            code = 0
        else:
            run_script("test.sh", rest)
    elif group == "version":
        from oroversion import cli
        code = cli.version_main(rest)
    elif group == "spec":
        from spectrace import cli as spec_cli
        code = spec_cli.main(rest)
    elif group == "dev" and rest[:1] == ["lint"]:
        from oroversion import cli
        code = cli.lint_main(rest[1:])
    elif group == "dev":
        sys.stdout.write(DEV_HELP) if not rest or rest[0] in HELPS else sys.stderr.write(DEV_HELP)
        code = 0 if not rest or rest[0] in HELPS else 64
    else:
        sys.stderr.write("aaxis-oro: unknown group %r\n%s" % (group, HELP))
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
