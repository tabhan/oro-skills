{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "aaxis-oro env.yml",
    "type": "object",
    "required": ["project"],
    "additionalProperties": true,
    "properties": {
        "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "app_root": {"type": "string"},
        "project_namespace": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "qa_server": {
            "type": "object",
            "properties": {
                "url": {"type": "string"},
                "db_dump": {"type": "string"},
                "attachments": {"type": "string"}
            }
        },
        "local": {
            "type": "object",
            "required": ["db"],
            "properties": {
                "domain": {"type": "string"},
                "tls_cert": {"type": "string"},
                "tls_key": {"type": "string"},
                "db": {"type": "string"}
            }
        },
        "local_test": {
            "type": "object",
            "required": ["db", "db_baseline", "es_prefix", "mq_vhost", "redis_dbs", "mongo_public", "mongo_private", "mongo_private_baseline"],
            "properties": {
                "domain": {"type": "string"},
                "tls_cert": {"type": "string"},
                "tls_key": {"type": "string"},
                "db": {"type": "string"},
                "db_baseline": {"type": "string"},
                "es_prefix": {"type": "string"},
                "mq_vhost": {"type": "string"},
                "redis_dbs": {"type": "array", "items": {"type": "integer"}},
                "mongo_public": {"type": "string"},
                "mongo_private": {"type": "string"},
                "mongo_private_baseline": {"type": "string"},
                "baseline_key": {"type": ["string", "null"]},
                "workers": {"type": "integer"},
                "workers_source": {"type": "string", "enum": ["auto", "user"]},
                "supervisor_consumer": {"type": "boolean"},
                "session_redis_db": {"type": "integer"},
                "admin": {
                    "type": "object",
                    "properties": {
                        "first": {"type": "string"},
                        "last": {"type": "string"},
                        "language": {"type": "string"},
                        "email": {"type": "string"}
                    }
                }
            }
        },
        "services": {
            "type": "object",
            "properties": {
                "mongo": {
                    "type": "object",
                    "properties": {
                        "port": {"type": "integer"},
                        "cache_gb": {"type": "number"},
                        "mem_limit": {"type": "string"}
                    }
                }
            }
        }
    }
}
