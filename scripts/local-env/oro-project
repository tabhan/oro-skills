#!/usr/bin/env bash
# oro: ">=7.0.0"
# Team-facing name for the host switch; the implementation is `aaxis-oro env switch`.
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ "${1:-}" = "--install" ]; then
    echo "SUDO-NEEDED: sudo ln -sf $HERE/oro-project /usr/local/bin/oro-project"; exit 10
fi
exec "$HERE/../../bin/aaxis-oro" env switch "$@"
