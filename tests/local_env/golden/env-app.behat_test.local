# Local test stack (behat_test kernel env), rendered from env.yml. Namespaces are oro_test*; app caches stay on disk,
# Redis holds only sessions (behat_test web). Derived DSNs are literal because dotenv expands ${VAR} when a file is read.
ORO_ENV=behat_test
ORO_DEBUG=0
ORO_MQ_DSN=amqp://mq:mqpass@127.0.0.1:5672/oro_test
ORO_SESSION_DSN=redis://127.0.0.1:6379/7
ORO_WEBSOCKET_SERVER_DSN=//0.0.0.0:8081
ORO_WEBSOCKET_FRONTEND_DSN=//*:8081/ws
ORO_WEBSOCKET_BACKEND_DSN=tcp://127.0.0.1:8081
ORO_DB_URL=postgres://pguser:pgpass@127.0.0.1:5432/oro_test?sslmode=disable&charset=utf8&serverVersion=17.6
ORO_DB_DSN=postgres://pguser:pgpass@127.0.0.1:5432/oro_test?sslmode=disable&charset=utf8&serverVersion=17.6
ORO_SEARCH_ENGINE_DSN=elastic-search://127.0.0.1:9200?prefix=oro_test_search
ORO_WEBSITE_SEARCH_ENGINE_DSN=elastic-search://127.0.0.1:9200?prefix=oro_test_website_search
ORO_MONGODB_DSN_PUBLIC=mongodb://127.0.0.1:27017/oro_test_public
ORO_MONGODB_DSN_PRIVATE=mongodb://127.0.0.1:27017/oro_test_private
E2E_WORKERS=2
